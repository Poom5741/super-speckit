{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Independent exact-candidate QA receipt",
 "type": "object",
 "required": ["candidate_sha", "checker", "worktree", "attempt_id", "environment", "matrix_digest", "environment_digest", "requirements", "gates"],
 "properties": {
  "candidate_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
  "checker": {"type": "string", "minLength": 1},
  "worktree": {"type": "string", "minLength": 1},
  "attempt_id": {"type": "string", "minLength": 1},
  "environment": {"type": "string", "minLength": 1},
  "environment_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
  "matrix_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
  "requirements": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/row"}, {"required": ["id", "kind", "public_seam"], "properties": {"kind": {"enum": ["runtime", "public-behavior"]}, "public_seam": {"type": "string", "minLength": 1}}}]}},
  "gates": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/row"}, {"required": ["command", "exit_code"], "properties": {"exit_code": {"const": 0}}}]}}
 },
 "$defs": {"row": {"type": "object", "required": ["status", "evidence", "evidence_digest"], "properties": {"status": {"const": "passed"}, "evidence": {"type": "string", "minLength": 1}, "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
