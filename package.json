{
  "name": "super-speckit-workspace",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build:v2": "pnpm check:v2 && node v2/scripts/build-opencode.mjs",
    "check:v2": "tsc -p v2/tsconfig.json --noEmit",
    "test:v2": "tsx --test v2/packages/**/*.test.ts",
    "test": "pnpm check:v2 && pnpm test:v2 && python3 -m unittest discover -s tests",
    "ssk2": "tsx v2/packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
